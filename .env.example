# Copy to .env and fill in for live LLM answers.
# Without any key the app runs in DEMO MODE: deterministic, rule-based
# analysis (JD extraction, fit scoring, tailoring) that works fully offline.

# --- LLM providers (checked in this order) ---
# Google Gemini — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# --- Local data (gitignored) ---
# Path to your real resume (PDF or .txt). Falls back to sample_data/sample_profile.md
RESUME_PATH=
# SQLite tracker database location
TRACKER_DB=data/tracker.db

# --- Job source API keys (all optional; Remotive/Arbeitnow/Greenhouse/Lever/Ashby need none) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
